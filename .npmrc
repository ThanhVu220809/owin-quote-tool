# npm 10.9.2 gãy khi giải đồ thị peer của vitest 4: "Cannot read properties of
# null (reading 'edgesOut')". Lỗi này CÓ TRƯỚC workspace — app cũ cài từ đầu
# cũng gãy y hệt, nó chỉ chạy được nhờ node_modules đã có sẵn.
#
# Đặt ở đây để `npm install` chạy được mà không phải nhớ cờ. Khi nâng npm lên
# bản đã sửa thì xoá dòng này và thử lại.
legacy-peer-deps=true
